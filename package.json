{
  "name": "salt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verifyPublicFolder.mjs && tsc -b && vite build && node scripts/verifyDistSecurity.mjs",
    "verify:dist": "node scripts/verifyDistSecurity.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed": "node scripts/seedFirestore.mjs",
    "create:test-user": "node scripts/createTestUser.mjs",
    "cleanup:expired-posts": "node scripts/cleanupExpiredPosts.mjs",
    "firebase": "firebase",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:firebase": "firebase deploy --only firestore:rules,firestore:indexes",
    "build:pages": "npm run build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:all": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.18.0",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
