rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function canUseApp() {
      return isSignedIn() && callerSchoolOk();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function authEmailDomain() {
      return request.auth.token.email.split('@')[1].lower();
    }

    function isAllowedSchool(domain) {
      return domain in ['uic.edu', 'illinois.edu', 'mit.edu'];
    }

    function callerSchool() {
      return authEmailDomain();
    }

    function callerSchoolOk() {
      return isSignedIn() && isAllowedSchool(callerSchool());
    }

    function sameSchool(data) {
      return callerSchoolOk() && data.schoolDomain.lower() == callerSchool();
    }

    function validUserCreate(uid) {
      return isOwner(uid)
        && canUseApp()
        && callerSchoolOk()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.schoolDomain == callerSchool()
        && request.resource.data.aura == 100
        && request.resource.data.postCount == 0
        && request.resource.data.meetCount == 0
        && request.resource.data.referralCount == 0
        && request.resource.data.referredByEmail == null
        && request.resource.data.referredByUid == null
        && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == null);
    }

    function replyCountOf(data) {
      return 'replyCount' in data ? data.replyCount : 0;
    }

    function postReplyIncrement() {
      return canUseApp()
        && callerSchoolOk()
        && sameSchool(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount == replyCountOf(resource.data) + 1;
    }

    function postScoreUpdate() {
      return canUseApp()
        && sameSchool(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score'])
        && request.resource.data.score is int
        && request.resource.data.score >= -500
        && request.resource.data.score <= 500;
    }

    function ownerProfileUpdate(uid) {
      return isOwner(uid)
        && canUseApp()
        && request.resource.data.email == resource.data.email
        && request.resource.data.schoolDomain == resource.data.schoolDomain
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.referredByUid == null
          || request.resource.data.referredByUid == resource.data.referredByUid);
    }

    function ownerStatsUpdate(uid) {
      return isOwner(uid)
        && canUseApp()
        && request.resource.data.email == resource.data.email
        && request.resource.data.schoolDomain == resource.data.schoolDomain
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (isOwner(uid) || sameSchool(resource.data));
      allow create: if validUserCreate(uid);
      allow update: if ownerProfileUpdate(uid) || ownerStatsUpdate(uid);
      allow delete: if isOwner(uid) && canUseApp();

      match /auraEvents/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && canUseApp();
        allow update: if false;
        allow delete: if isOwner(uid) && canUseApp();
      }

      match /voteIndex/{postId} {
        allow read, write: if isOwner(uid) && canUseApp();
        allow delete: if isOwner(uid) && canUseApp();
      }
    }

    match /posts/{postId} {
      allow get: if isSignedIn()
        && sameSchool(resource.data)
        && (resource.data.expiresAt > request.time
          || resource.data.authorUid == request.auth.uid);
      allow list: if isSignedIn()
        && callerSchoolOk()
        && resource.data.schoolDomain.lower() == callerSchool();
      allow create: if canUseApp()
        && callerSchoolOk()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.schoolDomain == callerSchool()
        && request.resource.data.score == 0
        && replyCountOf(request.resource.data) == 0
        && request.resource.data.expiresAt > request.time;
      allow update: if postReplyIncrement()
        || postScoreUpdate()
        || (canUseApp()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.schoolDomain == resource.data.schoolDomain
          && request.resource.data.score == resource.data.score);
      allow delete: if canUseApp() && resource.data.authorUid == request.auth.uid;

      match /votes/{voteUid} {
        allow read: if isSignedIn()
          && sameSchool(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create, update: if canUseApp()
          && voteUid == request.auth.uid
          && request.resource.data.value in [1, -1]
          && sameSchool(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow delete: if canUseApp() && (
          voteUid == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid
        );
      }
    }

    match /chats/{chatId} {
      allow get: if canUseApp() && callerSchoolOk() && (
        !exists(/databases/$(database)/documents/chats/$(chatId))
        || (request.auth.uid in resource.data.participantUids && sameSchool(resource.data))
      );
      allow list: if canUseApp()
        && callerSchoolOk()
        && request.auth.uid in resource.data.participantUids
        && sameSchool(resource.data);
      allow create: if canUseApp()
        && callerSchoolOk()
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.schoolDomain == callerSchool();
      allow update: if canUseApp()
        && callerSchoolOk()
        && request.auth.uid in resource.data.participantUids
        && sameSchool(resource.data);
      allow delete: if canUseApp()
        && request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        allow read: if canUseApp()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        allow create: if canUseApp()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        allow delete: if canUseApp()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        allow update: if false;
      }
    }

    match /meetRequests/{requestId} {
      allow read: if canUseApp()
        && (resource.data.requesterUid == request.auth.uid
          || resource.data.posterUid == request.auth.uid);
      allow list: if canUseApp()
        && (resource.data.requesterUid == request.auth.uid
          || resource.data.posterUid == request.auth.uid);
      allow create: if canUseApp()
        && requestId == request.resource.data.requesterUid + '_' + request.resource.data.postId
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.posterUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.schoolDomain.lower() == callerSchool()
        && request.resource.data.posterUid
          == get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorUid
        && sameSchool(get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data)
        && !exists(/databases/$(database)/documents/meetRequests/$(requestId));
      allow update: if canUseApp() && (
        (resource.data.posterUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'confirmed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']))
        || (resource.data.posterUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'declined'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (resource.data.requesterUid == request.auth.uid
          && resource.data.status == 'declined'
          && request.resource.data.status == 'pending'
          && request.resource.data.requesterUid == resource.data.requesterUid
          && request.resource.data.posterUid == resource.data.posterUid
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'requesterName', 'requesterInitials', 'postPreview', 'createdAt'
          ]))
      );
      allow delete: if canUseApp()
        && (resource.data.requesterUid == request.auth.uid
          || resource.data.posterUid == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.authorUid == request.auth.uid);
    }

    match /ratings/{ratingId} {
      allow read: if canUseApp()
        && (resource.data.reviewerUid == request.auth.uid
          || resource.data.targetUid == request.auth.uid);
      allow list: if canUseApp()
        && (resource.data.reviewerUid == request.auth.uid
          || resource.data.targetUid == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.authorUid == request.auth.uid);
      allow create: if canUseApp()
        && callerSchoolOk()
        && ratingId == request.auth.uid + '_' + request.resource.data.postId
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.applied == false
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.targetUid
          == get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorUid
        && sameSchool(get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data)
        && !exists(/databases/$(database)/documents/ratings/$(ratingId));
      allow update: if canUseApp()
        && resource.data.targetUid == request.auth.uid
        && resource.data.applied == false
        && request.resource.data.applied == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applied']);
      allow delete: if canUseApp()
        && (resource.data.reviewerUid == request.auth.uid
          || resource.data.targetUid == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.authorUid == request.auth.uid);
    }
  }
}
