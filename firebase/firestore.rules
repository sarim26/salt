rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function sameSchool(data) {
      return isSignedIn()
        && request.auth.token.schoolDomain != null
        && request.auth.token.schoolDomain == data.schoolDomain;
    }

    function protectedUserFieldsUnchanged() {
      return request.resource.data.aura == resource.data.aura
        && request.resource.data.badges == resource.data.badges
        && request.resource.data.meetCounts == resource.data.meetCounts
        && request.resource.data.meetCount == resource.data.meetCount
        && request.resource.data.postCount == resource.data.postCount
        && request.resource.data.schoolDomain == resource.data.schoolDomain
        && request.resource.data.email == resource.data.email;
    }

    function isChatParticipant(chatData) {
      return isSignedIn()
        && request.auth.uid in chatData.participantUids;
    }

    match /users/{uid} {
      allow read: if isSignedIn()
        && (isOwner(uid) || sameSchool(resource.data));
      allow create: if false;
      allow update: if isOwner(uid)
        && isVerified()
        && protectedUserFieldsUnchanged();
      allow delete: if false;

      match /auraEvents/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /posts/{postId} {
      allow read: if isSignedIn()
        && sameSchool(resource.data)
        && resource.data.expiresAt > request.time;
      allow create: if isVerified()
        && request.auth.token.schoolDomain != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.schoolDomain == request.auth.token.schoolDomain
        && request.resource.data.score == 0
        && request.resource.data.expiresAt > request.time;
      allow update: if isVerified()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.schoolDomain == resource.data.schoolDomain
        && request.resource.data.score == resource.data.score;
      allow delete: if isVerified()
        && resource.data.authorUid == request.auth.uid;

      match /votes/{voteUid} {
        allow read: if isSignedIn()
          && sameSchool(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create, update: if isVerified()
          && voteUid == request.auth.uid
          && request.resource.data.value in [1, -1]
          && sameSchool(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow delete: if isVerified() && voteUid == request.auth.uid;
      }
    }

    match /chats/{chatId} {
      allow read: if isVerified()
        && isChatParticipant(resource.data)
        && sameSchool(resource.data);
      allow create: if isVerified()
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.schoolDomain == request.auth.token.schoolDomain;
      allow update: if isVerified()
        && isChatParticipant(resource.data)
        && sameSchool(resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isVerified()
          && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if isVerified()
          && request.resource.data.senderUid == request.auth.uid
          && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow update, delete: if false;
      }
    }

    match /ratings/{ratingId} {
      allow read, write: if false;
    }
  }
}
