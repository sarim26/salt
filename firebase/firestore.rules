rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function authEmailDomain() {
      return request.auth.token.email.split('@')[1];
    }

    function isAllowedSchool(domain) {
      return domain in ['uic.edu', 'illinois.edu', 'mit.edu'];
    }

    function mySchool() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolDomain;
    }

    function sameSchool(data) {
      return isSignedIn() && mySchool() == data.schoolDomain;
    }

    function validUserCreate(uid) {
      return isOwner(uid)
        && isVerified()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.schoolDomain == authEmailDomain()
        && isAllowedSchool(request.resource.data.schoolDomain)
        && request.resource.data.aura == 247
        && request.resource.data.postCount == 0
        && request.resource.data.meetCount == 0
        && request.resource.data.referralCount == 0
        && request.resource.data.referredByEmail == null
        && request.resource.data.referredByUid == null;
    }

    function ownerProfileUpdate(uid) {
      return isOwner(uid)
        && isVerified()
        && request.resource.data.email == resource.data.email
        && request.resource.data.schoolDomain == resource.data.schoolDomain
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.referredByUid == null
          || request.resource.data.referredByUid == resource.data.referredByUid);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (isOwner(uid) || sameSchool(resource.data));
      allow create: if validUserCreate(uid);
      allow update: if ownerProfileUpdate(uid);
      allow delete: if false;

      match /auraEvents/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isVerified();
        allow update, delete: if false;
      }
    }

    match /posts/{postId} {
      allow read: if isSignedIn()
        && sameSchool(resource.data)
        && resource.data.expiresAt > request.time;
      allow create: if isVerified()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.schoolDomain == mySchool()
        && request.resource.data.score == 0
        && request.resource.data.expiresAt > request.time;
      allow update: if isVerified()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.schoolDomain == resource.data.schoolDomain
        && request.resource.data.score == resource.data.score;
      allow delete: if isVerified() && resource.data.authorUid == request.auth.uid;

      match /votes/{voteUid} {
        allow read: if isSignedIn()
          && sameSchool(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create, update: if isVerified()
          && voteUid == request.auth.uid
          && request.resource.data.value in [1, -1]
          && sameSchool(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow delete: if isVerified() && voteUid == request.auth.uid;
      }
    }

    match /chats/{chatId} {
      allow read: if isVerified()
        && request.auth.uid in resource.data.participantUids
        && sameSchool(resource.data);
      allow create: if isVerified()
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.schoolDomain == mySchool();
      allow update: if isVerified()
        && request.auth.uid in resource.data.participantUids
        && sameSchool(resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isVerified()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        allow create: if isVerified()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        allow update, delete: if false;
      }
    }

    match /ratings/{ratingId} {
      allow read: if isVerified()
        && (resource.data.reviewerUid == request.auth.uid
          || resource.data.targetUid == request.auth.uid);
      allow create: if isVerified()
        && ratingId == request.auth.uid + '_' + request.resource.data.postId
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.applied == false
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && !exists(/databases/$(database)/documents/ratings/$(ratingId));
      allow update: if isVerified()
        && resource.data.targetUid == request.auth.uid
        && resource.data.applied == false
        && request.resource.data.applied == true;
      allow delete: if false;
    }
  }
}
